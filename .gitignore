node_modules

# tools/ (AnCiR→Python port + JS↔Python parity harness) is version-controlled;
# only the venv and generated result files are ignored (see bottom of file).

# Output
/build/*
!/build/index.html
.output
.vercel
.netlify
.wrangler

# Handbook (workspace member) build output
/handbook/build/
/handbook/.svelte-kit/

# The handbook is built into static/ by `pnpm build` (so AnCiR's dev server serves
# /handbook.html and vite build copies it into build/). It's a generated artifact,
# not source — regenerated every build — so it must not be tracked (it's a 780 KB
# binary that would churn on every build).
/static/handbook.html

# The Python-export sidecar is assembled at build time from src/lib/utils/pythonExport.js
# and tools/ancir_runtime.py (both tracked). Derived, ~208 KB, and it would churn on every
# build, so it is generated rather than committed — see scripts/buildPythonExport.mjs.
/static/ancir-python-export.js
/.svelte-kit
tools/.svelte-kit/

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
nohup.out
node_modules/

# Local tooling / planning (not for remote)
.claude/
docs/
.planning/
.vscode/

# Local run artefacts (not for the repo)
add_output/
sine_output/
test-results/
diff_output/

# tools/: ignore the local venv and generated parity outputs (regenerated by the
# vitest emitters), but track the source (.py, README, fixtures, requirements).
tools/.venv/
tools/**/__pycache__/
tools/parity/js_results.json
tools/parity/session_js_results.json
